{
  "collection": "PRODUCTS",
  "document_id": "barcode",
  "description": "Firestore schema for enriched product documents (V1)",
  "fields": {
    "barcode": {
      "type": "string",
      "required": true,
      "description": "Unique GTIN/barcode (8, 12, 13, or 14 digits)",
      "constraints": "non-empty, numeric"
    },
    "productName": {
      "type": "string",
      "required": true,
      "description": "Primary product name (auto-filled fallback if missing)",
      "constraints": "non-empty"
    },
    "productNameSearch": {
      "type": "string",
      "required": false,
      "description": "Deterministic lowercase, NFC-normalized product name for prefix search",
      "constraints": "lowercase, NFC normalized"
    },
    "brand": {
      "type": "string",
      "required": false,
      "description": "Brand name (may be empty)"
    },
    "brandSearch": {
      "type": "string",
      "required": false,
      "description": "Deterministic lowercase, NFC-normalized brand name for prefix search",
      "constraints": "lowercase, NFC normalized"
    },
    "genericName": {
      "type": "string",
      "required": false
    },
    "additives": {
      "type": "array",
      "items": "string",
      "required": false,
      "description": "Additive codes (e.g., 'e202')"
    },
    "allergens": {
      "type": "array",
      "items": "string",
      "required": false,
      "description": "Detected allergens (e.g., 'Milk', 'Gluten')"
    },
    "ingredients": {
      "type": "array",
      "items": "string",
      "required": false
    },
    "ingredientsText": {
      "type": "string",
      "required": false
    },
    "ingredientsAnalysis": {
      "type": "array",
      "items": "string",
      "required": false
    },
    "categories": {
      "type": "array",
      "items": "string",
      "required": false
    },
    "category": {
      "type": "string",
      "required": false,
      "description": "Primary category (optional denormalised field; may mirror first categories[] entry)"
    },
    "labels": {
      "type": "array",
      "items": "string",
      "required": false
    },
    "nutrientLevels": {
      "type": "object",
      "required": false,
      "description": "Qualitative levels (e.g., { 'fat': 'moderate' })"
    },
    "nutriments": {
      "type": "object",
      "required": false,
      "description": "Normalized nutrition values (per 100g/serving)",
      "example_keys": [
        "energy-kcal_100g", "fat_100g", "carbohydrates_100g",
        "proteins_100g", "salt_100g"
      ]
    },
    "nutriments_normalized": {
      "type": "object",
      "required": false,
      "description": "Optional stored per-100g-style block; API may also derive from nutriments"
    },
    "nutriscoreGrade": {
      "type": "string",
      "required": false,
      "enum": ["a", "b", "c", "d", "e", "unknown"]
    },
    "productQuantity": {
      "type": "number",
      "required": false
    },
    "productQuantityUnit": {
      "type": "string",
      "required": false
    },
    "servingQuantity": {
      "type": "number",
      "required": false
    },
    "servingQuantityUnit": {
      "type": "string",
      "required": false
    },
    "traces": {
      "type": "string",
      "required": false
    },
    "tracesFromIngredients": {
      "type": "string",
      "required": false
    },
    "completeness": {
      "type": "number",
      "required": false,
      "constraints": "0 to 1 (percentage)"
    },
    "images": {
      "type": "object",
      "required": false,
      "required_subfields": ["root"],
      "subfields": {
        "root": { "type": "string" },
        "primary": { "type": "string" },
        "variants": { "type": "object" }
      }
    },
    "tags": {
      "type": "object",
      "required": false,
      "description": "Product tags: resolved {final, removed} and/or raw list input for pipelines",
      "subfields": {
        "final": { "type": "array", "items": "string" },
        "removed": { "type": "array", "items": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "required": false,
      "description": "Enrichment provenance / quality (general)",
      "subfields": {
        "enrichmentSource": { "type": "string" },
        "enrichmentTimestamp": { "type": "string" },
        "dataQualityScore": { "type": "number" }
      }
    },
    "enrichmentMetadata": {
      "type": "object",
      "required": false,
      "description": "Recommendation-facing metadata (lighter than full enrichment tree)",
      "subfields": {
        "recommendationScore": { "type": "number" },
        "reasonTags": { "type": "array", "items": "string" },
        "similarityMetrics": { "type": "object" }
      }
    },
    "dateAdded": {
      "type": "string",
      "required": false,
      "description": "ISO timestamp when product document was created"
    },
    "lastUpdated": {
      "type": "string",
      "required": false,
      "description": "ISO timestamp when product document was last updated"
    },
    "productJson": {
      "type": "object",
      "required": false,
      "description": "Optional cart snapshot blob (full serialised product); keep in sync with wire fields when used"
    },
    "enrichment": {
      "type": "object",
      "required": false,
      "subfields": {
        "nutrition": {
          "type": "object",
          "required_subfields": ["compositeScore", "scores"]
        },
        "alternatives": {
          "type": "object",
          "description": "DB019 similar/healthier peer lists (see database/pipeline/modules/DB019_README.md)"
        }
      }
    }
  },
  "indexes": [
    { "fields": ["categories", "allergens"], "description": "Diet/allergen filtering" },
    { "fields": ["enrichment.nutrition.compositeScore"], "direction": "DESCENDING", "description": "Nutrition quality sorting" },
    { "fields": ["nutriscoreGrade"], "description": "Quick grade filter" },
    { "fields": ["enrichment.tags"], "description": "Array-contains for diet/lifestyle tags" },
    { "fields": ["brand", "nutriscoreGrade"], "description": "Brand + quality combo" },
    { "fields": ["productNameSearch"], "description": "Prefix query index for search by product name" },
    { "fields": ["brandSearch"], "description": "Prefix query index for search by brand" },
    { "fields": ["brandSearch", "productNameSearch"], "description": "Compound search by brand and product name" }
  ]
}
