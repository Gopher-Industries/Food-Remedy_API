rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedInOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAllowedAvatarType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp'
      ];
    }

    function isAllowedAvatarSize() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    match /USERS/{uid}/PROFILES/{profileId}/{fileName} {
      function isAvatarFile() {
        return fileName.matches('avatar\\.(jpg|png|webp)');
      }

      allow read, delete: if isAvatarFile() && isSignedInOwner(uid);
      allow create, update: if isAvatarFile()
        && isSignedInOwner(uid)
        && isAllowedAvatarType()
        && isAllowedAvatarSize();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
