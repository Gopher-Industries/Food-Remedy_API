                "catalogue",
                "manual",
                "deterministic",
                "model_inferred"
              ]
            },
            "sourceVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "generatedAt": {
              "type": "string",
