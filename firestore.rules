rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function existingProfile(uid, profileId) {
      let path = /databases/$(database)/documents/USERS/$(uid)/PROFILES/$(profileId);
      return exists(path);
    }
    function activeProfile(uid, profileId) {
      let path = /databases/$(database)/documents/USERS/$(uid)/PROFILES/$(profileId);
      return existingProfile(uid, profileId) && get(path).data.status != false;
    }
    function validIntent(profileId, intentId) {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'intentId', 'profileId', 'text', 'provenance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'intentId', 'profileId', 'text', 'occasion', 'convenience', 'provenance', 'createdAt', 'updatedAt', 'deletedAt'])
        && data.schemaVersion == '1.0.0' && data.intentId == intentId && data.profileId == profileId
        && data.text is string && data.text.size() > 0 && data.text.size() <= 240
        && data.provenance == 'explicit'
        && data.createdAt is string && data.createdAt.size() <= 35
        && data.updatedAt is string && data.updatedAt.size() <= 35
        && (!('deletedAt' in data) || (data.deletedAt is string && data.deletedAt.size() <= 35))
        && (!('deletedAt' in data) || (data.text == '(deleted)' && !('occasion' in data) && !('convenience' in data)))
        && (!('occasion' in data) || data.occasion in ['breakfast', 'lunchbox', 'commute', 'snack', 'shared', 'recipe', 'other'])
        && (!('convenience' in data) || data.convenience in ['ready_to_eat', 'minimal_prep', 'requires_prep']);
    }

    match /USERS/{uid} {
      allow read, write: if owner(uid);
      match /PROFILES/{profileId} {
        allow read, write: if owner(uid);
        match /PERSONALIZATION/{documentId} {
          allow read: if owner(uid) && documentId == 'preferences' && existingProfile(uid, profileId);
          // Full 32-entry schema validation runs in the authenticated backend endpoint.
          allow create, update: if false;
          allow delete: if owner(uid) && documentId == 'preferences';
        }
        match /SAVED_INTENTS/{intentId} {
          allow read: if owner(uid) && existingProfile(uid, profileId);
          allow create, update: if owner(uid) && activeProfile(uid, profileId) && validIntent(profileId, intentId);
          allow delete: if owner(uid);
        }
      }
      match /SHOPPING_LISTS/{listId} {
        allow read, write: if owner(uid);
        match /ITEMS/{itemId} {
          allow read, write: if owner(uid);
        }
      }
    }
    match /users/{uid} {
      allow read, write: if owner(uid);
      match /cart/{productId} {
        allow read, write: if owner(uid);
      }
    }
    match /FEEDBACK/{feedbackId} {
      allow create: if request.auth != null
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow read, update, delete: if false;
    }
    match /PRODUCTS/{productId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
